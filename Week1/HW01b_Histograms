import java.io.FileReader;
import java.io.IOException;
import java.util.Scanner;

public class HW01b_Histograms {
    public static void main(String[] args) throws IOException {

        Scanner UserInput = new Scanner(System.in);
        System.out.print("Enter input file name: ");
        // Collect the file name from the user
        String fileName = UserInput.next();
        System.out.println();

        // Create a file reader so we can identify the file
        FileReader fr = new FileReader(fileName);
        // Create a scanner to scan the contents in the file provided using the previous file reader.
        Scanner fs = new Scanner(fr);

        // If the file has an int, go into the if statement
        if(fs.hasNextInt()){

            // Setting the first number to count, this is the given size of the array assuming. First number provided in the file.
            int count = fs.nextInt();

            // assignArr | Method that will assign file values to an array called histNums
            int[] histNums = assignArr(count, fs);

            System.out.println("===== Horizontal Histogram =====");

            // Method to print out the histogram
            printHistogram(histNums);
        }
        fs.close();
    }

    public static void printHistogram(int histNums[]){
        for(int j = 0; j < histNums.length; j++){
            int currentValue = histNums[j];
            System.out.print(currentValue + ": ");

            for(int k = 0; k < currentValue; k++){
                System.out.print("* ");
            }
            System.out.println();
        }
    }

    public static int[] assignArr(int count, Scanner fs){
        int [] fileNums = new int[count];

        for(int i = 0; i < count; i++){
            if(fs.hasNextInt()){
                fileNums[i] = fs.nextInt();
            }
        }
        return fileNums;
    }


}
